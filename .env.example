# Copy to .env and adjust. Nothing here is required for the core system.

# API
CODEFUSION_CONFIG=configs/full.yaml
# CODEFUSION_INDEX_DIR=artifacts/index
# 1 = fall back to hashing embeddings if the configured model cannot be downloaded
CODEFUSION_ALLOW_FALLBACK=0

# Hugging Face (optional: only raises rate limits; all default models are public)
# HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING=1
TOKENIZERS_PARALLELISM=false

# MLflow (optional; enable with tracking.mlflow=true in a config)
# MLFLOW_TRACKING_URI=file:./artifacts/mlruns

# Neo4j (optional; only for scripts/export_neo4j.py / the neo4j compose profile)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codefusion

# Joern (optional experimental CPG; path to the joern-parse / joern binaries directory)
# JOERN_HOME=
